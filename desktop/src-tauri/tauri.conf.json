{
  "$schema": "https://raw.githubusercontent.com/nicholasgasior/tauri-config-schema/tauri-v2/schema.json",
  "productName": "ClassicPOS",
  "version": "1.0.0",
  "identifier": "com.oakitsolutions.classicpos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClassicPOS — Offline Desktop POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* https://api.github.com https://*.oakitsolutionsandsupplies.com; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../backend/app/**/*",
      "../backend/bootstrap/**/*",
      "../backend/config/**/*",
      "../backend/database/**/*",
      "../backend/public/**/*",
      "../backend/resources/**/*",
      "../backend/routes/**/*",
      "../backend/storage/**/*",
      "../backend/vendor/**/*"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "php",
          "sidecar": true,
          "args": true
        },
        {
          "name": "cloudflared",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "updater": {
      "pubkey": "PUBLIC_KEY_HERE",
      "endpoints": [
        "https://github.com/OAK-IT-Solutions/classicpos-Lite/releases/latest/download/latest.json"
      ]
    }
  }
}
