APP_NAME=ClassicPOS
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:18900
APP_KEY=

DB_CONNECTION=sqlite
DB_DATABASE=data/classicpos.sqlite

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Landlord DB not needed in offline mode
CLASSICPOS_SELF_HOSTED=true

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:18900

CORS_ALLOWED_ORIGINS=*

# Offline mode — no Redis required
# REDIS_HOST, REDIS_PORT, REDIS_PASSWORD not needed
