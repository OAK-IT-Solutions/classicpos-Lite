APP_NAME=ClassicPOS
APP_ENV=local
APP_DEBUG=true
APP_URL=https://localhost:9099
APP_KEY=

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5444
DB_DATABASE=classicpos
DB_USERNAME=classicpos
DB_PASSWORD=secret

# Landlord Database (for SaaS mode — stores tenants, subscriptions, agents, tickets)
LANDLORD_DB_CONNECTION=landlord
LANDLORD_DB_HOST=db
LANDLORD_DB_PORT=5444
LANDLORD_DB_DATABASE=classicpos_landlord
LANDLORD_DB_USERNAME=classicpos
LANDLORD_DB_PASSWORD=secret

# Tenant Resolution
TENANT_RESOLUTION=manual
CLASSICPOS_SELF_HOSTED=true
SINGLE_TENANT_SLUG=default
TENANT_DB_PREFIX=classicpos_tenant_

REDIS_HOST=redis
REDIS_PORT=6444
REDIS_PASSWORD=null

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:9099,localhost:5173

CORS_ALLOWED_ORIGINS=*

SESSION_SECURE_COOKIE=true

PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CURRENCY=USD

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=

LOG_CHANNEL=stack
LOG_STACK=single,sentry_logs
LOG_LEVEL=debug

# Sentry Error Tracking
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=true

# API Rate Limiting
API_RATE_LIMIT=120

# Audit Trail
AUDIT_LOG_RETENTION_MONTHS=24
AUDIT_LOG_REQUESTS=true
